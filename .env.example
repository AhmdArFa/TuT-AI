# MCIT AI configuration
# Copy to .env and replace every CHANGE_ME value before the first start.
# Generate secrets with:  openssl rand -hex 32

# =============================================================================
# REQUIRED
# =============================================================================

# Encrypts provider API keys stored in the database
OPEN_NOTEBOOK_ENCRYPTION_KEY=CHANGE_ME
# Signs MCIT AI sign-in sessions and office/viewer links
MCIT_AUTH_SECRET=CHANGE_ME
# Shared secret between MCIT AI and the office viewer (ONLYOFFICE Docs)
ONLYOFFICE_JWT_SECRET=CHANGE_ME

# =============================================================================
# ACCOUNTS
# =============================================================================
# The bootstrap administrator is created on first start. Change the password
# from the admin console (or here, before the first start) for any shared
# deployment. Only administrators create accounts and set passwords.
MCIT_ADMIN_USERNAME=admin
MCIT_ADMIN_PASSWORD=1234
# Hours a sign-in stays valid
# MCIT_SESSION_HOURS=12

# Address users open in the browser (used for the shared login)
MCIT_PUBLIC_URL=http://localhost:8502

# =============================================================================
# DATABASE
# =============================================================================
# Every account gets its own private database inside this namespace.
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=mcit_ai
SURREAL_DATABASE=core

# =============================================================================
# MODELS (local by default)
# =============================================================================
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Background tasks running at once (1 suits a single local GPU/CPU)
OPEN_NOTEBOOK_WORKER_MAX_TASKS=1

# =============================================================================
# OFFICE VIEWER
# =============================================================================
# Address the browser loads the viewer from
ONLYOFFICE_PUBLIC_URL=http://localhost:8082

# =============================================================================
# CRAFT ENGINES (inside the MCIT AI image)
# =============================================================================
# CRAFT_BIN_DIR=/opt/craft/bin
# CRAFT_TIMEOUT_SECONDS=180
# CRAFT_MAX_PARALLEL=2

# =============================================================================
# TUT AGENT (starts with the rest of the platform)
# =============================================================================
TUT_AGENT_PUBLIC_URL=http://localhost:3210
TUT_OIDC_CLIENT_ID=tut-agent
TUT_OIDC_CLIENT_SECRET=CHANGE_ME
# Unlike other secrets, Tut's vault key must decode from base64 to 32 bytes.
# Generate with: openssl rand -base64 32
TUT_KEY_VAULTS_SECRET=CHANGE_ME_BASE64_32_BYTES
TUT_AUTH_SECRET=CHANGE_ME
TUT_POSTGRES_PASSWORD=CHANGE_ME
TUT_STORAGE_ACCESS_KEY=tut
TUT_STORAGE_SECRET_KEY=CHANGE_ME
TUT_GATEWAY_TOKEN=CHANGE_ME
# Server-to-server token: admin console reads Tut Agent chats, files and usage,
# and MCIT AI connects each user's Tut Agent to the MCIT AI tools
TUT_ADMIN_TOKEN=CHANGE_ME
# Longest time one Studio drafting call may take (seconds); raise on slow CPUs
# TUT_DRAFT_TIMEOUT_SECONDS=900
# Browser-reachable addresses of Tut Agent's file storage and gateway
TUT_S3_PUBLIC_URL=http://localhost:9000
TUT_GATEWAY_PUBLIC_URL=http://localhost:8787

# =============================================================================
# OPTIONAL
# =============================================================================
# Upload size: UNLIMITED by default, any PDF size is accepted. Set a positive
# number of MB here only if a deployment wants to reject oversized bodies.
# OPEN_NOTEBOOK_MAX_UPLOAD_SIZE_MB=500
# Bytes streamed per read while saving an upload (default 1 MB)
# OPEN_NOTEBOOK_UPLOAD_STREAM_CHUNK_BYTES=1048576
# Context size above which a large-context model is provisioned
# OPEN_NOTEBOOK_LARGE_CONTEXT_THRESHOLD=105000
# Largest document the office viewer may save back, in MB (default 100)
# OPEN_NOTEBOOK_OFFICE_MAX_SAVE_MB=100
# Office-viewer ticket validity, in hours (default 4)
# OPEN_NOTEBOOK_OFFICE_TICKET_HOURS=4
# Body size cap for uploads proxied through the frontend /api path
# (default 10gb; the direct API path is uncapped)
# FRONTEND_PROXY_MAX_BODY_SIZE=10gb
# Centralized service addresses and model defaults (all overridable here):
# MCIT_INTERNAL_API_URL=http://localhost:5055
# OLLAMA_API_BASE=http://localhost:11434
# OMLX_API_BASE=http://localhost:11435/v1
# SURREAL_ADDRESS=localhost

# Corporate proxy. NO_PROXY must list the internal hosts.
# HTTP_PROXY=http://proxy.corp.example:8080
# HTTPS_PROXY=http://proxy.corp.example:8080
# NO_PROXY=localhost,127.0.0.1,surrealdb,office,ollama,kokoro,mcit-ai,tut-agent

# Expose the interactive API reference at /docs (off by default)
# MCIT_EXPOSE_API_DOCS=false
